---
import Base from '../layouts/Base.astro';
import EditionItem from '../components/EditionItem.astro';
import { type Lang } from '../i18n';
import { getEditions, seriesVars, type Series } from '../lib';

interface Props {
  lang: Lang;
  series: Series;
}
const { lang, series } = Astro.props;
const T = { en: 'Editions', es: 'Ediciones', pt: 'Edições' };
const s = series.data;
const editions = (await getEditions()).filter((e) => e.data.series.id === series.id);
---
<Base lang={lang} path={`/series/${series.id}`} title={s.name} description={s.summary[lang]}>
  <header class="page-head wrap">
    <p class="eyebrow series-scope series-text" style={seriesVars(series)}>{s.fullName[lang]}</p>
    <h1>{s.name}</h1>
    <p>{s.summary[lang]}</p>
  </header>
  <div class="wrap">
    <div class="prose">
      {s.about[lang].map((p) => <p>{p}</p>)}
    </div>
    <h2>{T[lang]}</h2>
    <ul class="edition-list">
      {editions.map((e) => <EditionItem lang={lang} edition={e} series={series} />)}
    </ul>
  </div>
</Base>
