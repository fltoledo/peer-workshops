---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { LANG_META, UI, countryName, lp, type Lang } from '../i18n';
import { editionLanguage, editionTheme, editionWhen, editionWhere, getSeriesMap, participantCount, seriesVars, tx, type Edition } from '../lib';

interface Props {
  lang: Lang;
  edition: Edition;
}
const { lang, edition } = Astro.props;

const T = {
  en: {
    facts: 'Edition details', when: 'When', where: 'Where', host: 'Host', organizers: 'Organizers', theme: 'Theme', venue: 'Venue', language: 'Language', role: 'Federico’s role', contentOwner: 'Content Owner', official: 'Official page',
    openTitle: 'Call open', deadline: 'Applications until', apply: 'Apply', ask: 'Ask us', guide: 'How to put together a good experience report →',
    plannedTitle: 'Coming soon', plannedText: 'Date, place and theme will be announced soon. The call is not open yet.', notify: 'Let me know when it opens',
    closedTitle: 'Applications closed', closedText: 'We are selecting participants. Subscribe to hear about the next edition.',
    pastTitle: 'Edition held', pastText: 'Want to take part in the next edition of', notifyShort: 'Let me know', hostedText: 'The regional continuation of this workshop, in Spanish, is', hostedLink: 'See WOPR Latam',
    summary: 'How it went', photos: 'Photos', openPhoto: 'open full size', participants: 'Participants', topics: 'Topics discussed', by: 'by',
  },
  es: {
    facts: 'Datos de la edición', when: 'Cuándo', where: 'Dónde', host: 'Host', organizers: 'Organización', theme: 'Temática', venue: 'Sede', language: 'Idioma', role: 'Rol de Federico', contentOwner: 'Content Owner', official: 'Página oficial',
    openTitle: 'Convocatoria abierta', deadline: 'Postulaciones hasta el', apply: 'Postularme', ask: 'Consultar', guide: 'Cómo armar un buen reporte de experiencia →',
    plannedTitle: 'Próximamente', plannedText: 'Pronto anunciamos fecha, lugar y temática. La convocatoria todavía no está abierta.', notify: 'Avisame cuando abra',
    closedTitle: 'Postulaciones cerradas', closedText: 'Ya estamos seleccionando participantes. Suscribite para enterarte de la próxima edición.',
    pastTitle: 'Edición realizada', pastText: '¿Querés participar en la próxima edición de', notifyShort: 'Avisame', hostedText: 'La continuidad regional de este taller, en español, es el', hostedLink: 'Ver WOPR Latam',
    summary: 'Cómo fue', photos: 'Fotos', openPhoto: 'ver en tamaño completo', participants: 'Participantes', topics: 'Temas tratados', by: 'por',
  },
  pt: {
    facts: 'Dados da edição', when: 'Quando', where: 'Onde', host: 'Host', organizers: 'Organização', theme: 'Tema', venue: 'Local', language: 'Idioma', role: 'Papel de Federico', contentOwner: 'Content Owner', official: 'Página oficial',
    openTitle: 'Inscrições abertas', deadline: 'Inscrições até', apply: 'Inscrever-me', ask: 'Fale com a gente', guide: 'Como montar um bom relato de experiência →',
    plannedTitle: 'Em breve', plannedText: 'Em breve anunciaremos data, local e tema. A chamada ainda não está aberta.', notify: 'Avise-me quando abrir',
    closedTitle: 'Inscrições encerradas', closedText: 'Estamos selecionando participantes. Inscreva-se para saber da próxima edição.',
    pastTitle: 'Edição realizada', pastText: 'Quer participar da próxima edição do', notifyShort: 'Avise-me', hostedText: 'A continuidade regional deste workshop, em espanhol, é o', hostedLink: 'Ver WOPR Latam',
    summary: 'Como foi', photos: 'Fotos', openPhoto: 'ver em tamanho real', participants: 'Participantes', topics: 'Temas discutidos', by: 'por',
  },
};
const t = T[lang];
const series = (await getSeriesMap()).get(edition.data.series.id)!;
const d = edition.data;
const deadline = d.applyDeadline?.toLocaleDateString(LANG_META[lang].intl, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const theme = editionTheme(edition, lang);
// Foto de fondo del encabezado: `cover` o la primera de la galería.
const cover = d.cover ?? d.photos[0]?.src;

// Versión grande y optimizada de cada foto, para el enlace "ver en tamaño completo".
const photos = await Promise.all(
  d.photos.map(async (p) => ({
    ...p,
    alt: tx(p.alt, lang),
    caption: p.caption && tx(p.caption, lang),
    full: (await getImage({ src: p.src, width: Math.min(p.src.width, 2000), format: 'webp', quality: 80 })).src,
  })),
);
const people = [...d.participants].sort((a, b) => a.name.localeCompare(b.name, LANG_META[lang].intl));
const count = participantCount(edition);
---
<Base
  lang={lang}
  path={`/editions/${edition.id}`}
  title={d.title}
  description={`${d.title}${theme ? `: ${theme}` : ''}. ${editionWhere(edition, lang)}, ${editionWhen(edition, lang)}.`}
>
  <header class={cover ? 'hero hero-photo edition-hero series-scope' : 'page-head wrap series-scope'} style={seriesVars(series)}>
    {cover && (
      <Picture
        class="hero-bg"
        src={cover}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2400]}
        width={1600}
        sizes="100vw"
        quality={60}
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class={cover ? 'wrap hero-inner' : undefined}>
      <Breadcrumbs
        lang={lang}
        items={[
          { href: lp(lang, '/editions'), label: UI[lang].nav.editions },
          { href: lp(lang, `/series/${series.id}`), label: series.data.name },
        ]}
        current={d.title}
      />
      <h1>{d.title}</h1>
      {theme && <p class="lead">{theme}</p>}
      <span class={`badge badge-${d.status}`}>{UI[lang].status[d.status]}</span>
    </div>
  </header>

  <div class="wrap">
    <div class="grid grid-2" style="margin-top: 24px">
      <div class="card">
        <h2 class="sr-only">{t.facts}</h2>
        <dl class="facts">
          <dt>{t.when}</dt><dd>{editionWhen(edition, lang)}</dd>
          <dt>{t.where}</dt><dd>{editionWhere(edition, lang)}</dd>
          {d.host && <><dt>{t.host}</dt><dd>{d.host}</dd></>}
          {d.venue && <><dt>{t.venue}</dt><dd>{d.venue}</dd></>}
          {d.organizers.length > 0 && <><dt>{t.organizers}</dt><dd>{d.organizers.join(', ')}</dd></>}
          {d.contentOwner && <><dt>{t.contentOwner}</dt><dd>{d.contentOwner}</dd></>}
          {theme && <><dt>{t.theme}</dt><dd>{theme}</dd></>}
          <dt>{t.language}</dt><dd>{editionLanguage(edition, lang)}</dd>
          <dt>{t.role}</dt><dd>{UI[lang].myRole[d.myRole]}</dd>
          {d.url && <><dt>{t.official}</dt><dd><a href={d.url} target="_blank" rel="noopener">{new URL(d.url).hostname}</a></dd></>}
          {count > 0 && <><dt>{t.participants}</dt><dd>{count}</dd></>}
        </dl>
      </div>
      <div class="card">
        {d.status === 'open' && (
          <>
            <h2 class="h3">{t.openTitle}</h2>
            {deadline && <p class="muted">{t.deadline} {deadline}.</p>}
            {d.applyUrl
              ? <a class="btn btn-primary" href={d.applyUrl} target="_blank" rel="noopener">{t.apply}</a>
              : <a class="btn btn-primary" href={lp(lang, '/contact')}>{t.ask}</a>}
            <p style="margin-top: 12px"><a href={lp(lang, '/participate#report')}>{t.guide}</a></p>
          </>
        )}
        {d.status === 'planned' && (
          <>
            <h2 class="h3">{t.plannedTitle}</h2>
            <p class="muted">{t.plannedText}</p>
            <a class="btn btn-primary" href="#newsletter">{t.notify}</a>
          </>
        )}
        {d.status === 'closed' && (
          <>
            <h2 class="h3">{t.closedTitle}</h2>
            <p class="muted">{t.closedText}</p>
          </>
        )}
        {d.status === 'past' && d.myRole === 'organizer' && (
          <>
            <h2 class="h3">{t.pastTitle}</h2>
            <p class="muted">{t.pastText} {series.data.name}?</p>
            <a class="btn btn-ghost" href="#newsletter">{t.notifyShort}</a>
          </>
        )}
        {d.status === 'past' && d.myRole === 'host' && (
          <>
            <h2 class="h3">{t.pastTitle}</h2>
            <p class="muted">{t.hostedText} WOPR Latam.</p>
            <a class="btn btn-ghost" href={lp(lang, '/series/wopr-latam')}>{t.hostedLink}</a>
          </>
        )}
      </div>
    </div>

    {d.summary && (
      <section class="section prose">
        <h2>{t.summary}</h2>
        <p>{d.summary[lang]}</p>
      </section>
    )}

    {photos.length > 0 && (
      <section class="section">
        <h2>{t.photos}</h2>
        <ul class="gallery">
          {photos.map((p, i) => (
            <li class={i === 0 && photos.length > 2 ? 'gallery-wide' : undefined}>
              <figure>
                <a href={p.full}>
                  <Picture
                    src={p.src}
                    alt={p.alt}
                    formats={['avif', 'webp']}
                    widths={i === 0 && photos.length > 2 ? [640, 1040, 1600, 2080] : [400, 640, 1040]}
                    width={i === 0 && photos.length > 2 ? 1040 : 640}
                    sizes={i === 0 && photos.length > 2
                      ? '(max-width: 1080px) calc(100vw - 40px), 1040px'
                      : '(max-width: 640px) calc(100vw - 40px), (max-width: 1080px) 50vw, 520px'}
                    quality={65}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <span class="sr-only">({t.openPhoto})</span>
                </a>
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    {(d.topics.length > 0 || people.length > 0) && (
      <div class="grid grid-2 section" style="align-items: start">
        {d.topics.length > 0 && (
          <section>
            <h2>{t.topics}</h2>
            <ol class="topics">
              {d.topics.map((topic) => (
                <li>
                  <span class="topic-title">{tx(topic.title, lang)}</span>
                  {topic.presenter && <span class="muted"> · {t.by} {topic.presenter}</span>}
                </li>
              ))}
            </ol>
          </section>
        )}
        {people.length > 0 && (
          <section>
            <h2>{t.participants} <span class="muted">({count})</span></h2>
            <ul class="people">
              {people.map((p) => (
                <li>
                  {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a> : <span>{p.name}</span>}
                  {(p.org || p.country) && (
                    <span class="muted">{[p.org, p.country && countryName(p.country, lang)].filter(Boolean).join(' · ')}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}
  </div>
</Base>
